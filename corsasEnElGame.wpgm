import wollok.game.*

import vehiculos.*

program CorsaGame {
    const cachito = new Corsa(color = rojo)
    game.title("Corsita")
    game.width(10)
    game.height(10)
    game.addVisualCharacter(cachito)

    keyboard.r().onPressDo {cachito.cambiarColor(rojo)}
    keyboard.a().onPressDo {cachito.cambiarColor(azul)}
    keyboard.v().onPressDo {cachito.cambiarColor(verde)}
    
    game.start()
}
